# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build/*

# ...except the generated design tokens, which are tracked so a fresh clone
# builds without running `npm run tokens` first.
!/build/css

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code local settings
.claude/settings.local.json

# MCP server config. Local-only: it names dev servers and is the file a token
# would land in if one were ever needed, so it stays out of the repo.
.mcp.json

# Fonts are tracked, not ignored. next/font/local reads app/GreedCollectionVF-TRIAL.ttf
# at build time, so a clone without it — Vercel's, or anyone else's — fails to build.

*storybook.log
storybook-static
